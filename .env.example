# Copy to .env and fill in. Never commit .env.
COSMOS_URL=https://<cosmos-host>
COSMOS_TOKEN=cosmos_xxx
COSMOS_READ_ONLY=false
COSMOS_VERIFY_TLS=true
# HTTP mode (optional): serve MCP over HTTP instead of stdio
# COSMOS_MCP_TRANSPORT=http
# COSMOS_MCP_AUTH_TOKEN=generate-with-python3-secrets-token_urlsafe-32
# COSMOS_MCP_HOST=127.0.0.1
# COSMOS_MCP_PORT=8000
